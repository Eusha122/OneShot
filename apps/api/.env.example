# ── AI Provider ────────────────────────────────────────────────────────────────
# local       → always use local Ollama (default)
# production  → always use cloud AI  (Ollama not required)
# fallback    → use Ollama, switch to cloud only when Ollama fails
AI_PROVIDER=local

# ── Local Ollama ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
INFERENCE_TIMEOUT=60

# ── Cloud AI (DigitalOcean AI agent or any OpenAI-compatible endpoint) ──────────
# Required when AI_PROVIDER=production or AI_PROVIDER=fallback
CLOUD_AI_URL=https://your-cloud-ai-endpoint.example/api/v1
CLOUD_AI_KEY=your-bearer-token-here
CLOUD_AI_MODEL=                        # leave blank for DO agents (model is fixed per agent)
